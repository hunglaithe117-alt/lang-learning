{
  "name": "lang-learning",
  "version": "1.0.0",
  "private": true,
  "description": "Language Learning Platform - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=@lang-learning/server",
    "dev:web": "turbo run dev --filter=@lang-learning/web",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=@lang-learning/server",
    "build:web": "turbo run build --filter=@lang-learning/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:db": "docker-compose -f docker-compose.db.yml up -d",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.0"
}