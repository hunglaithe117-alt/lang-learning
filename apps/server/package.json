{
    "name": "@lang-learning/server",
    "version": "0.0.1",
    "description": "Language Learning - NestJS GraphQL API Server",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "migrate:dev": "prisma migrate dev",
        "migrate:dev:create": "prisma migrate dev --create-only",
        "migrate:reset": "prisma migrate reset",
        "migrate:deploy": "npx prisma migrate deploy",
        "migrate:status": "npx prisma migrate status",
        "migrate:resolve": "npx prisma migrate resolve",
        "prisma:studio": "npx prisma studio",
        "prisma:generate": "npx prisma generate",
        "prisma:generate:watch": "npx prisma generate --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "seed": "prisma db seed",
        "postinstall": "npm run prisma:generate || true"
    },
    "dependencies": {
        "@apollo/server": "^5.0.0",
        "@devoxa/prisma-relay-cursor-connection": "^3.1.3",
        "@nestjs/apollo": "^13.2.4",
        "@nestjs/common": "^11.1.15",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.15",
        "@nestjs/graphql": "^13.2.4",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.15",
        "@nestjs/swagger": "^11.2.6",
        "@prisma/adapter-pg": "^7.4.0",
        "@prisma/client": "^7.4.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^16.4.0",
        "graphql": "^16.13.1",
        "graphql-scalars": "^1.25.0",
        "graphql-subscriptions": "^3.0.0",
        "nestjs-prisma": "^0.27.0",
        "passport": "^0.7.0",
        "passport-jwt": "4.0.1",
        "pg": "^8.13.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@swc/cli": "^0.1.62",
        "@swc/core": "^1.3.70",
        "@types/bcrypt": "^5.0.2",
        "@types/chance": "1.1.3",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "@types/supertest": "2.0.12",
        "chance": "1.1.11",
        "eslint": "^9.0.0",
        "eslint-plugin-prettier": "^5.2.0",
        "jest": "29.6.1",
        "prettier": "^3.5.0",
        "prisma": "^7.4.0",
        "prisma-dbml-generator": "0.11.0-dev.0",
        "supertest": "6.3.3",
        "ts-jest": "29.1.1",
        "ts-loader": "9.4.4",
        "ts-node": "10.9.1",
        "tsconfig-paths": "4.2.0",
        "tsx": "^4.0.0",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.0.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}